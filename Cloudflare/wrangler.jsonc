{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aetherserpent-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoomDO"
      },
      {
        "name": "WORLD_ZONE",
        "class_name": "WorldZoneDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoomDO",
        "WorldZoneDO"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "JWT_SECRET": "aether-serpent-eternal-coil-production-secret-key-32chars",
    "JWT_REFRESH_SECRET": "aether-serpent-refresh-secret-production-key-32chars",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA", // Cloudflare test secret key (always passes)
    "ALLOWED_ORIGINS": "*"
  }
}
